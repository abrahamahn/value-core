{
  "name": "@abrahamahn/value-core",
  "version": "0.3.0",
  "description": "Domain-neutral value accounting, transfer, hold, reversal, and reconciliation primitives.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamahn/value-core.git",
    "directory": "typescript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "type-check": "pnpm typecheck",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.26.2",
  "publishConfig": {
    "access": "public"
  }
}
